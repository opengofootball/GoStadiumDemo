[node name="InstructionsPanel" type="PanelContainer" parent="HUD"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -120.0
offset_right = 420.0
offset_bottom = -16.0
grow_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Instructions" type="Label" parent="HUD/InstructionsPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.92, 0.95, 1)
theme_override_font_sizes/font_size = 13
text = "🎮 Controls:
 • WASD: Walk / Fly around
 • Mouse: Look around (captured)
 • Shift: Sprint speed boost
 • Space / E: Ascend | Ctrl / Q: Descend
 • Mouse Wheel: Adjust speed
 • ESC / Tab: Toggle mouse capture | F1: Hide HUD"

[node name="MouseHint" type="Label" parent="HUD"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -180.0
offset_top = 12.0
offset_right = 180.0
offset_bottom = 35.0
grow_horizontal = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 13
text = "Press [ESC] to release mouse for UI"
horizontal_alignment = 1

[node name="MessageToast" type="Label" parent="HUD"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -250.0
offset_right = 200.0
offset_bottom = -215.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(1, 0.95, 0.6, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
text = "Loaded Stadium"
horizontal_alignment = 1

[connection signal="pressed" from="HUD/MainPanel/VBox/ViewpointsRow/BtnPitch" to="." method="teleport_to_viewpoint" binds= ["pitch"]]
[connection signal="pressed" from="HUD/MainPanel/VBox/ViewpointsRow/BtnSideline" to="." method="teleport_to_viewpoint" binds= ["aerial"]]
[connection signal="pressed" from="HUD/MainPanel/VBox/ViewpointsRow/BtnAerial" to="." method="teleport_to_viewpoint" binds= ["overview"]]
[connection signal="pressed" from="HUD/MainPanel/VBox/ViewpointsRow/BtnGoalNorth" to="." method="teleport_to_viewpoint" binds= ["goal1"]]
[connection signal="pressed" from="HUD/MainPanel/VBox/ViewpointsRow/BtnGoalSouth" to="." method="teleport_to_viewpoint" binds= ["goal2"]]
[connection signal="value_changed" from="HUD/MainPanel/VBox/SpeedBox/SpeedSlider" to="." method="_on_speed_slider_value_changed"]
[connection signal="value_changed" from="HUD/MainPanel/VBox/TimeBox/TimeSlider" to="." method="_on_time_slider_value_changed"]
[connection signal="value_changed" from="HUD/MainPanel/VBox/CloudBox/CoverageSlider" to="." method="_on_coverage_slider_value_changed"]
[connection signal="value_changed" from="HUD/MainPanel/VBox/DensityBox/DensitySlider" to="." method="_on_density_slider_value_changed"]
