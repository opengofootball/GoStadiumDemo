[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="Environment" path="res://sky/stadium_sky.tres" id="2_env"]
[ext_resource type="Script" path="res://camera/walk_camera.gd" id="3_cam"]
[ext_resource type="PackedScene" path="res://pitch/common_pitch.tscn" id="4_pitch"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.08, 0.09, 0.12, 0.85)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.965926, -0.183013, 0.183013, 0, 0.707107, 0.707107, -0.258819, -0.683013, 0.683013, 0, 100, 0)
shadow_enabled = true
shadow_bias = 0.03
directional_shadow_mode = 2
directional_shadow_max_distance = 250.0

[node name="WalkCamera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
near = 0.15
far = 1200.0
script = ExtResource("3_cam")
move_speed = 8.0
sprint_factor = 3.0

[node name="CommonPitch" parent="." instance=ExtResource("4_pitch")]

[node name="HUD" type="CanvasLayer" parent="."]

[node name="MainPanel" type="PanelContainer" parent="HUD"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -440.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 320.0
grow_horizontal = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="HUD/MainPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="HUD/MainPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "⚽ Common Pitch (130×90 m)"
horizontal_alignment = 1

[node name="HSeparator1" type="HSeparator" parent="HUD/MainPanel/VBox"]
layout_mode = 2

[node name="ViewpointsTitle" type="Label" parent="HUD/MainPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Quick Teleport Viewpoints:"

[node name="ViewpointsRow" type="HBoxContainer" parent="HUD/MainPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BtnPitch" type="Button" parent="HUD/MainPanel/VBox/ViewpointsRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Pitch"

[node name="BtnSideline" type="Button" parent="HUD/MainPanel/VBox/ViewpointsRow"]
layout_mode = 2
