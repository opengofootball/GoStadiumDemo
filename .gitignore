# Godot 4 specific ignores
.godot/
*.import.tmp

# Godot import metadata files (regenerated automatically by the editor on each machine)
*.import

# Godot script/resource UID sidecars (regenerated by the editor)
*.uid

# WSL / Windows metadata
*.Zone.Identifier

# Godot Engine executable binary
Godot_v4.6.3-stable_linux.x86_64

# Textures auto-extracted by the glTF importer next to stadium .glb files.
# They are embedded inside the .glb, so we do not track the loose copies.
stadiums/**/*.png
stadiums/**/*.jpg
stadiums/**/*.jpeg

# Stadium models are split into parts each < 50 MB (see tools/split_glb.py), so the
# .glb parts are versioned normally. The single pre-split source export (439 MB) is
# kept out because it exceeds GitHub's 100 MB per-file hard limit.
stadiums/**/modern_stadium.glb
